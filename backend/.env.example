ENVIRONMENT=development
PORT=8000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
MONGODB_URI=
MONGODB_DB_NAME=noterootai
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
JWT_SECRET=
ENCRYPTION_KEY=
CHROMA_PERSIST_DIR=/data/chroma_db
DEFAULT_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CHAT_MODEL_OPENAI=gpt-4o-mini
DEFAULT_CHAT_MODEL_ANTHROPIC=claude-3-5-haiku-20241022
DEFAULT_CHAT_MODEL_GEMINI=gemini-1.5-flash
DEFAULT_CHAT_MODEL_MISTRAL=mistral-small-latest
DEFAULT_CHAT_MODEL_GROQ=llama-3.3-70b-versatile
# Optional server-side defaults. User-configured provider keys remain encrypted in MongoDB.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
