ENVIRONMENT=development
PORT=8000
# Comma-separated CORS origins. For production deployments on Render/Vercel, include your frontend domain:
# e.g., CLIENT_ORIGINS=https://noteroot-ai.vercel.app,http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
MONGODB_URI=
MONGODB_DB_NAME=noterootai
DATABASE_MAX_POOL_SIZE=5
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_MAX_CONNECTION_POOL_SIZE=5
JWT_SECRET=
ENCRYPTION_KEY=
DEFAULT_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CHAT_MODEL_OPENAI=gpt-4o-mini
DEFAULT_CHAT_MODEL_GEMINI=gemini-3.5-flash
DEFAULT_CHAT_MODEL_MISTRAL=mistral-small-latest
DEFAULT_CHAT_MODEL_GROQ=llama-3.3-70b-versatile
# Optional server-side defaults. User-configured provider keys remain encrypted in MongoDB.
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Web Search Provider (tavily | brave | searxng)
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
